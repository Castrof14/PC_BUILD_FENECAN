# Endereco da API que o sistema operador consome.
# Desenvolvimento: aponta para a Mock API (tools/mock-api.ts) em http://localhost:3000
# Feira (API real): http://ENDERECO-DA-API-REAL:PORTA
API_URL=http://localhost:3000

# Intervalo da atualizacao automatica dos pedidos, em milissegundos.
POLL_INTERVAL_MS=2000

# Tempo limite de cada requisicao HTTP, em milissegundos.
REQUEST_TIMEOUT_MS=5000

# Porta do servidor local da interface do operador.
OPERATOR_PORT=4000

# Abrir o navegador automaticamente ao iniciar (true/false).
AUTO_OPEN_BROWSER=true

# Abrir em tela cheia, sem barra de endereco (true/false).
KIOSK_MODE=true

# Tocar um som quando chegar pedido novo (true/false).
NEW_ORDER_SOUND=true

# ---------------------------------------------------------------------------
# Backend da O.S. (npm run os:start)
# ---------------------------------------------------------------------------

# Onde as O.S. ficam guardadas. Hoje so existe "memory" (temporario).
# Banco: veja BACKEND.md, "Guia: conectar o banco de dados oficial". As builds
# ja ficam no banco do fenecan-backend (BUILD_STORAGE=mysql) e voltam para a
# O.S. no retrato inicial do WebSocket quando ela reinicia.
ORDER_STORAGE=memory

# De onde chegam os pedidos:
#   none    = nada chega
#   mock    = pedidos de exemplo (so desenvolvimento)
#   fenecan = builds enviadas pelo site, via fenecan-backend (interligando/)
ORDER_PROVIDER=fenecan

# WebSocket da O.S. no fenecan-backend (PORT + OS_WS_PATH de la).
FENECAN_WS_URL=ws://localhost:3000/ws/os

# Porta da API local da O.S. (GET /orders, PATCH /orders/:id/status),
# consumida pela tela do operador no Tauri. Se mudar, ajuste tambem
# VITE_OS_API_URL abaixo.
OS_HTTP_PORT=4100

# Endereco da API local da O.S. usado pela tela (O.S/web). Lido pelo Vite.
VITE_OS_API_URL=http://127.0.0.1:4100

# Prefixo dos IDs gerados (PED-001, PED-002, ...).
ORDER_ID_PREFIX=PED

# Com ORDER_PROVIDER=mock: gera um pedido de exemplo a cada N ms (0 = desligado).
MOCK_ORDER_INTERVAL_MS=0
