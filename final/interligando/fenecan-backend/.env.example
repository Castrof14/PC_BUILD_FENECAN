# Copie para `.env` e preencha com os dados do seu ambiente.
#   cp .env.example .env
# Nunca comite o `.env` (já está no .gitignore).

# ------------------------------------------------------------------
# Servidor HTTP + WebSocket (mesma porta, mesmo processo)
# ------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Nível de log do Fastify: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# CORS. Vazio ou "*" = liberado para qualquer origem (desenvolvimento do
# app mobile). Para restringir ao site oficial:
# CORS_ORIGIN=https://site.fenecan.com
CORS_ORIGIN=

# Caminho do WebSocket da Unity
WS_PATH=/ws

# Caminho do WebSocket da O.S. (sistema do operador). A O.S. conecta aqui
# e recebe cada build criada/alterada (ver docs/WEBSOCKET.md).
OS_WS_PATH=/ws/os

# ------------------------------------------------------------------
# Banco de dados (MySQL)
# ------------------------------------------------------------------

# Onde as builds ficam guardadas:
#   mysql  = persistência real (padrão)
#   memory = sem banco, tudo em memória (desenvolvimento/demonstração;
#            os dados somem quando o servidor encerra)
# Quando o MySQL estiver disponível: preencha DATABASE_URL e troque para mysql.
BUILD_STORAGE=memory

# Opção 1 (recomendada): tudo em uma URL.
DATABASE_URL=mysql://USUARIO:SENHA@127.0.0.1:3306/montagens_db

# Opção 2: variáveis separadas (usadas quando DATABASE_URL não existir).
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=USUARIO
# DB_PASSWORD=SENHA
# DB_NAME=montagens_db

# Cria a tabela `builds` automaticamente ao subir o servidor
AUTO_MIGRATE=true

# O banco precisa existir uma vez (o servidor cria a tabela, não o banco):
#   CREATE DATABASE montagens_db
#     CHARACTER SET utf8mb4
#     COLLATE utf8mb4_unicode_ci;

# ------------------------------------------------------------------
# Testes (opcional)
# ------------------------------------------------------------------
# Banco usado por `npm test`. Deriva do DATABASE_URL com o sufixo `_test`
# e é recriado do zero a cada execução.
# TEST_DATABASE=montagens_db_test

# Endereço do simulador da Unity (`npm run unity:sim`).
# BACKEND_URL=ws://localhost:3000/ws

# Quanto tempo o simulador "monta" cada build, em ms.
# SIMULATED_BUILD_MS=1200
