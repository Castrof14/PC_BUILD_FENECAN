{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Build Simulator OS",
  "version": "0.1.0",
  "identifier": "com.cliente.app",
  "build": {
    "beforeDevCommand": "npm run os:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run os:build",
    "frontendDist": "../../O.S/web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PC Build Simulator — O.S.",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
