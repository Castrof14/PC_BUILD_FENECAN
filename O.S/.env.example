# Endereco da API que o sistema operador consome.
# Desenvolvimento: aponta para a Mock API (tools/mock-api.ts) em http://localhost:3000
# Feira (API real): http://ENDERECO-DA-API-REAL:PORTA
API_URL=http://localhost:3000

# Intervalo da atualizacao automatica dos pedidos, em milissegundos.
POLL_INTERVAL_MS=2000

# Tempo limite de cada requisicao HTTP, em milissegundos.
REQUEST_TIMEOUT_MS=5000

# Porta do servidor local da interface do operador.
OPERATOR_PORT=4000

# Abrir o navegador automaticamente ao iniciar (true/false).
AUTO_OPEN_BROWSER=true

# Abrir em tela cheia, sem barra de endereco (true/false).
KIOSK_MODE=true

# Tocar um som quando chegar pedido novo (true/false).
NEW_ORDER_SOUND=true
