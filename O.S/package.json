{
  "name": "pc-build-simulator-operator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema operador do PC Build Simulator. Consome a API de pedidos, mostra para o operador e altera o status dos pedidos.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "start:operator": "npm run build:web && tsx src/main.ts",
    "dev:operator": "npm run build:web && tsx watch src/main.ts",
    "build:web": "tsc -p tsconfig.web.json",
    "typecheck:operator": "tsc -p tsconfig.json --noEmit",
    "clean": "node --eval \"const{rmSync}=require('node:fs');for(const d of ['dist','web-dist','web/dist','.test-dist','.os-dist'])rmSync(d,{recursive:true,force:true})\"",
    "mock:api": "tsx tools/mock-api.ts",
    "os:build": "node --eval \"require('node:fs').rmSync('.os-dist',{recursive:true,force:true})\" && tsc -p tsconfig.os.json",
    "os:start": "npm run os:build && node .os-dist/os-main.js",
    "test": "node --eval \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node scripts/run-tests.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.1"
  }
}
